---
import "../styles/global.css";
import Chrome from "../components/Chrome.astro";
import { SITE, LANGS, OG_LOCALE, dirOf, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternates: Record<Lang, string>;
  graph?: object[];
  ogType?: string;
  meta?: { property: string; content: string }[];
}
const { lang, title, description, alternates, graph = [], ogType = "website", meta = [] } = Astro.props;
const url = SITE + alternates[lang];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${SITE}/#site`, name: "EasyShoot", url: `${SITE}/` },
    { "@type": "WebPage", "@id": `${url}#page`, url, name: title, description, inLanguage: lang, isPartOf: { "@id": `${SITE}/#site` }, about: { "@id": `${SITE}/#app` } },
    ...graph,
  ],
};
---
<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
<meta name="application-name" content="EasyShoot">
<link rel="canonical" href={url}>
{LANGS.filter(l => alternates[l]).map(l => <link rel="alternate" hreflang={l} href={SITE + alternates[l]}>)}
<link rel="alternate" hreflang="x-default" href={SITE + alternates.en}>
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly summary">
<link rel="sitemap" href="/sitemap-index.xml">
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="EasyShoot">
<meta property="og:locale" content={OG_LOCALE[lang]}>
{LANGS.filter(l => l !== lang && alternates[l]).map(l => <meta property="og:locale:alternate" content={OG_LOCALE[l]}>)}
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={`${SITE}/og.png`}>
{meta.map(m => <meta property={m.property} content={m.content}>)}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={title}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`${SITE}/og.png`}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icon.png">
<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0A0A0B" media="(prefers-color-scheme: dark)">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap">
<script is:inline>
  document.documentElement.classList.add("js");
  try { var t = localStorage.getItem("easyshoot-theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {}
</script>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
<Chrome lang={lang} alternates={alternates}><slot /></Chrome>
<script>
  import "../scripts/site.ts";
</script>
</body>
</html>
