---
import Base from "../layouts/Base.astro";
import { SITE, APP_STORE_URL, pagePath, useT, type Lang } from "../i18n";
import { content, articleOf, hubPath, articlePath, alternatesFor, tagsFor, wordCount, readingTime, TOC_LABEL, GUIDES, COMPARES, type Article } from "../i18n/articles";
import { appNode, faqNode, breadcrumbNode } from "../lib/seo";

interface Props { lang: Lang; article: Article }
const { lang, article } = Astro.props;
const t = useT(lang);
const ui = content(lang).ui;
const a = articleOf(lang, article.slug);
const path = articlePath(lang, article);
const url = SITE + path;
const isGuide = article.kind === "guides";
const storeHref = APP_STORE_URL || pagePath(lang) + "#get";
const tags = tagsFor(lang, article.slug);
const words = wordCount(a);
const published = "2026-11-01";
const modified = "2026-11-01";
const crumbs = [
  { name: ui.home, path: pagePath(lang) },
  { name: ui[article.kind], path: hubPath(lang, article.kind) },
  { name: a.short, path },
];
const related = [...(isGuide ? GUIDES : COMPARES).filter(x => x.slug !== article.slug), ...(isGuide ? COMPARES : GUIDES).slice(0, 2)];
const toc = [
  ...(a.steps ? [{ id: "steps", h: ui.steps }] : []),
  ...(a.table ? [{ id: "table", h: a.competitor }] : []),
  ...a.sections.map((s: { h2: string }, i: number) => ({ id: `s${i + 1}`, h: s.h2 })),
  { id: "faq", h: ui.faq },
];

const graph: object[] = [
  appNode(lang),
  breadcrumbNode(url, crumbs),
  faqNode(url, lang, a.faq),
  {
    "@type": isGuide ? "TechArticle" : "Article",
    "@id": `${url}#article`,
    headline: a.h1,
    description: a.description,
    inLanguage: lang,
    keywords: tags.join(", "),
    articleSection: ui[article.kind],
    wordCount: words,
    datePublished: published,
    dateModified: modified,
    image: `${SITE}/og.png`,
    author: { "@type": "Organization", name: "EasyShoot", url: `${SITE}/` },
    publisher: { "@type": "Organization", name: "EasyShoot", logo: { "@type": "ImageObject", url: `${SITE}/icon.png` } },
    mainEntityOfPage: url,
    about: { "@id": `${SITE}/#app` },
    ...(article.kind === "compare" ? { mentions: [{ "@type": "SoftwareApplication", name: a.competitor }] } : {}),
  },
];
if (isGuide && a.steps) {
  graph.push({
    "@type": "HowTo",
    "@id": `${url}#howto`,
    name: a.h1,
    inLanguage: lang,
    tool: { "@type": "HowToTool", name: "EasyShoot" },
    step: a.steps.map((s: { name: string; text: string }, i: number) => ({ "@type": "HowToStep", position: i + 1, name: s.name, text: s.text, url: `${url}#step-${i + 1}` })),
  });
}
const meta = [
  { property: "article:published_time", content: published },
  { property: "article:modified_time", content: modified },
  { property: "article:section", content: ui[article.kind] },
  ...tags.map(tag => ({ property: "article:tag", content: tag })),
];
---
<Base lang={lang} title={a.title} description={a.description} alternates={alternatesFor(l => articlePath(l, article))} graph={graph} ogType="article" meta={meta}>
<main class="doc">
  <div class="wrap doc-layout">
    <article class="doc-main">
      <nav class="crumbs reveal" aria-label="Breadcrumb">
        <ol>{crumbs.map((cr, i) => <li>{i < crumbs.length - 1 ? <a href={cr.path}>{cr.name}</a> : <span aria-current="page">{cr.name}</span>}</li>)}</ol>
      </nav>
      <header class="doc-head reveal">
        <h1>{a.h1}</h1>
        <p class="doc-lead">{a.intro}</p>
        <div class="doc-meta">
          <a class="pill-tag kind" href={hubPath(lang, article.kind)}>{ui[article.kind]}</a>
          <span>{readingTime(lang, words)}</span>
          <span aria-hidden="true">·</span>
          <time datetime={modified}>{ui.updated}</time>
        </div>
        <ul class="tag-list" aria-label="Tags">{tags.map(tag => <li class="pill-tag">{tag}</li>)}</ul>
      </header>

      {a.steps && (
        <section class="doc-section doc-steps reveal" id="steps" aria-labelledby="steps-h">
          <h2 id="steps-h"><a class="anchor" href="#steps" aria-hidden="true">#</a>{ui.steps}</h2>
          <ol>{a.steps.map((s: { name: string; text: string }, i: number) => <li id={`step-${i + 1}`}><strong>{s.name}</strong><span>{s.text}</span></li>)}</ol>
        </section>
      )}

      {a.table && (
        <section class="doc-section doc-table reveal" id="table" aria-label={a.competitor}>
          <div class="table-scroll">
            <table>
              <thead><tr><th scope="col">{ui.feature}</th><th scope="col"><span class="wm" dir="ltr">Easy<span class="s">Shoot</span></span></th><th scope="col">{a.competitor}</th></tr></thead>
              <tbody>{a.table.map((row: string[]) => <tr><th scope="row">{row[0]}</th><td data-label="EasyShoot">{row[1]}</td><td data-label={a.competitor}>{row[2]}</td></tr>)}</tbody>
            </table>
          </div>
          <p class="doc-note">{ui.sources}</p>
        </section>
      )}

      {a.sections.map((s: { h2: string; html: string }, i: number) => (
        <section class="doc-section reveal" id={`s${i + 1}`} aria-labelledby={`s${i + 1}-h`}>
          <h2 id={`s${i + 1}-h`}><a class="anchor" href={`#s${i + 1}`} aria-hidden="true">#</a>{s.h2}</h2>
          <div class="prose" set:html={s.html} />
        </section>
      ))}

      <section class="doc-section doc-faq reveal" id="faq" aria-labelledby="faq-h">
        <h2 id="faq-h"><a class="anchor" href="#faq" aria-hidden="true">#</a>{ui.faq}</h2>
        <div class="faq">{a.faq.map((f: { q: string; a: string }, i: number) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
      </section>

      <aside class="doc-cta reveal">
        <img src="/icon.png" width="72" height="72" alt="" loading="lazy">
        <div><h2>{ui.ctaTitle}</h2><p>{ui.ctaBody}</p></div>
        <a class="btn btn-dark" href={storeHref}>{t("hero.cta")}</a>
      </aside>

      <nav class="doc-section doc-related reveal" aria-labelledby="rel-h">
        <h2 id="rel-h">{ui.related}</h2>
        <ul>{related.map(r => <li><a href={articlePath(lang, r)}><span>{articleOf(lang, r.slug).h1}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></li>)}</ul>
      </nav>
    </article>
    <aside class="doc-toc" aria-label={TOC_LABEL[lang]}>
      <p>{TOC_LABEL[lang]}</p>
      <ol>{toc.map(x => <li><a href={`#${x.id}`}>{x.h}</a></li>)}</ol>
    </aside>
  </div>
</main>
</Base>
