---
import { LANGS, LANG_NAMES, APP_STORE_URL, pagePath, privacyPath, supportPath, useT, type Lang } from "../i18n";
import { GUIDES, COMPARES, articlePath } from "../i18n/articles";

interface Props { lang: Lang; alternates: Record<Lang, string> }
const { lang, alternates } = Astro.props;
const t = useT(lang);
const home = pagePath(lang);
const storeHref = APP_STORE_URL || home + "#get";
const privacyHref = privacyPath(lang);
const supportHref = supportPath(lang);
---


<div class="ambient" aria-hidden="true"><i></i><i></i><i></i></div>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs><linearGradient id="g" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#0E95EE"/><stop offset="1" stop-color="#27C9F5"/></linearGradient></defs>
  <symbol id="es-mark" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"/></g><circle cx="12" cy="12" r="3.6" fill="currentColor"/></symbol>
</svg>

<header class="top">
  <div class="wrap nav">
    <a class="brand wm" href={pagePath(lang)} dir="ltr"><img src="/icon.png" width="30" height="30" alt=""><span>Easy<span class="s">Shoot</span></span></a>
    <nav class="links">
      <a href={home + "#features"}>{t("nav.features")}</a>
      <a href={home + "#tools"}>{t("nav.tools")}</a>
      <a href={home + "#privacy"}>{t("nav.privacy")}</a>
      <a href={home + "#faq"}>{t("nav.faq")}</a>
    </nav>
    <div class="tools">
      <details class="lang">
        <summary class="chip-btn" aria-label={t("lang.label")}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>
          <span>{lang.toUpperCase()}</span>
        </summary>
        <ul class="lang-menu">
          {LANGS.map(l => <li><a href={alternates[l] ?? pagePath(l)} hreflang={l} lang={l} aria-current={l === lang ? "page" : undefined}>{LANG_NAMES[l]} <small>{l.toUpperCase()}</small></a></li>)}
        </ul>
      </details>
      <button class="chip-btn" id="themeBtn" type="button" aria-label={t("theme.toggle")} data-to-light={t("theme.toLight")} data-to-dark={t("theme.toDark")}>
        <svg class="theme-light-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-dark-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      </button>
      <a class="btn btn-dark" href={storeHref}>{t("nav.download")}</a>
    </div>
  </div>
</header>

<slot />

<footer class="site-foot">
  <div class="wrap">
    <div class="foot-card">
      <div class="foot-brand">
        <a class="brand wm" href={pagePath(lang)} dir="ltr"><img src="/icon.png" width="40" height="40" alt="" loading="lazy"><span>Easy<span class="s">Shoot</span></span></a>
        <p>{t("foot.about")}</p>
        <a class="btn btn-dark" href={storeHref}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg><span>{t("hero.cta")}</span></a>
      </div>
      <nav class="foot-cols" aria-label={t("foot.product")}>
        <div><h4>{t("foot.product")}</h4><ul><li><a href={home + "#features"}>{t("nav.features")}</a></li><li><a href={home + "#tools"}>{t("nav.tools")}</a></li><li><a href={home + "#privacy"}>{t("nav.privacy")}</a></li><li><a href={home + "#faq"}>{t("nav.faq")}</a></li></ul></div>
        <div><h4>{t("foot.guides")}</h4><ul>{GUIDES.map(a => <li><a href={articlePath(lang, a)}>{a.short[lang]}</a></li>)}</ul></div>
        <div><h4>{t("foot.compare")}</h4><ul>{COMPARES.map(a => <li><a href={articlePath(lang, a)}>{a.short[lang]}</a></li>)}</ul></div>
        <div><h4>{t("foot.help")}</h4><ul><li><a href={supportHref}>{t("foot.support")}</a></li><li><a href={privacyHref}>{t("foot.privacy")}</a></li><li><a href={home + "changelog/"}>{t("foot.changelog")}</a></li><li><a href={home + "press/"}>{t("foot.press")}</a></li><li><a href={home + "sitemap/"}>{t("map.title")}</a></li></ul></div>
      </nav>
    </div>
    <div class="foot-bar">
      <span>© 2026 EasyShoot</span>
      <ul class="foot-langs">
        {LANGS.map(l => <li><a href={alternates[l] ?? pagePath(l)} hreflang={l} lang={l} aria-current={l === lang ? "page" : undefined}>{LANG_NAMES[l]}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
