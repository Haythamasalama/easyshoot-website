---
import { APP_STORE_URL, privacyPath, useT, tabsFor, type Lang } from "../i18n";
import { edHTML, shotHTML } from "../lib/editor";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const TAB_MODES = ["mark", "shape", "pixel", "bg", "ar"];
const TABS = tabsFor(lang);
const storeHref = APP_STORE_URL || "#get";
const privacyHref = privacyPath(lang);
const headingTail = t("seo.title").split(/\s*:\s*/)[1];
---
<main id="top">

<section class="hero">
  <div class="wrap">
    <img class="hero-icon" src="/icon.png" width="150" height="150" alt={t("icon.alt")} fetchpriority="high">
    <div class="hero-copy">
      <h1><span dir="ltr">Easy<span class="grad-text">Shoot</span></span><span class="sr-only">: {headingTail}</span></h1>
      <p class="lead" set:html={t("hero.sub")} />
      <div class="actions">
        <a class="btn btn-dark" href={storeHref}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg><span>{t("hero.cta")}</span></a>
        <a class="btn btn-line" href="#features">{t("hero.cta2")}</a>
      </div>
      <p class="fine">{t("hero.meta")}</p>
    </div>
    <div class="desk">
      <div class="menubar" aria-hidden="true">
        <svg width="14" height="16" viewBox="0 0 14 17" fill="#fff"><path d="M11.6 9c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.8-3.1.8-.7 0-1.6-.8-2.7-.7C3.2 4.3 1.9 5.1 1.2 6.4c-1.5 2.6-.4 6.4 1 8.5.7 1 1.5 2.2 2.6 2.1 1 0 1.4-.7 2.7-.7s1.6.7 2.7.6c1.1 0 1.8-1 2.5-2 .8-1.2 1.1-2.3 1.1-2.4-.1 0-2.2-.8-2.2-3.5zM9.5 2.8c.6-.7 1-1.6.8-2.6-.8 0-1.8.6-2.4 1.3-.5.6-1 1.6-.9 2.5.9.1 1.8-.5 2.5-1.2z"/></svg>
        <b>EasyShoot</b><span>File</span><span>Edit</span><span>View</span><span>Window</span>
        <span class="r"><svg class="mark" viewBox="0 0 24 24" style="color:#fff"><use href="#es-mark"/></svg><span>Sun 1 Nov&nbsp; 9:41</span></span>
      </div>
      <div class="editor-win"><div class="ed m-mark" role="img" aria-label={t("hero.alt")} set:html={edHTML("mark", lang)} /></div>
    </div>
  </div>
</section>

<section class="section" id="features">
  <div class="wrap">
    <div class="center narrow reveal">
      <span class="eyebrow">{t("flow.eyebrow")}</span>
      <h2 class="h2">{t("flow.title")}</h2>
      <p class="sub">{t("flow.sub")}</p>
    </div>
    <div class="flow">
      <article class="flow-card reveal">
        <span class="n">01</span><h3>{t("flow.1t")}</h3><p>{t("flow.1b")}</p>
        <div class="flow-art" aria-hidden="true"><div class="sel-art"><div class="sel-box"></div><span class="sel-size">1280 × 720</span><svg class="crosshair" viewBox="0 0 18 18"><path d="M9 0v18M0 9h18" stroke="#fff" stroke-width="1.5"/></svg></div></div>
      </article>
      <article class="flow-card reveal">
        <span class="n">02</span><h3>{t("flow.2t")}</h3><p>{t("flow.2b")}</p>
        <div class="flow-art" aria-hidden="true"><div class="qa"><div class="thumb"><div class="crop" dir="ltr"><span class="cl">Promo code</span><span class="cr"><span class="ci">Enter code</span><span class="ca">Apply</span><b>1</b></span><span class="cp">Pay $48.00</span></div></div><div class="qa-btns"><span>{t("ui.copy")}</span><span>{t("ui.save")}</span><span class="pri">{t("ui.edit")}</span></div></div></div>
      </article>
      <article class="flow-card reveal">
        <span class="n">03</span><h3>{t("flow.3t")}</h3><p>{t("flow.3b")}</p>
        <div class="flow-art" aria-hidden="true"><div class="chat"><span class="bub in">{t("chat.1")}</span><span class="bub img"><i><div class="crop" dir="ltr"><span class="cl">Promo code</span><span class="cr"><span class="ci">Enter code</span><span class="ca">Apply</span><b>1</b></span><span class="cp">Pay $48.00</span></div></i></span><span class="bub out">{t("chat.2")}</span></div></div>
      </article>
    </div>
  </div>
</section>

<section class="section" id="tools">
  <div class="wrap">
    <div class="center narrow reveal">
      <span class="eyebrow">{t("tools.eyebrow")}</span>
      <h2 class="h2" set:html={t("tools.title")} />
      <p class="sub">{t("tools.sub")}</p>
    </div>

    <div class="toolrow reveal" role="group" aria-label={t("nav.tools")}>
      <button class="tool" type="button" aria-pressed="false"><span class="ic"><svg viewBox="0 0 40 40"><path d="M9 31L29 11M17 11h12v12" fill="none" stroke="url(#g)" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="lbl">{t("t.arrow")}</span><span class="key">A</span></button>
      <button class="tool" type="button" aria-pressed="false"><span class="ic"><svg viewBox="0 0 40 40"><rect x="7" y="10" width="26" height="20" rx="3" fill="none" stroke="url(#g)" stroke-width="3.4"/></svg></span><span class="lbl">{t("t.rect")}</span><span class="key">R</span></button>
      <button class="tool" type="button" aria-pressed="false"><span class="ic"><svg viewBox="0 0 40 40"><path d="M20 7l13 13-13 13L7 20z" fill="none" stroke="url(#g)" stroke-width="3.4" stroke-linejoin="round"/></svg></span><span class="lbl">{t("t.diamond")}</span><span class="key">D</span></button>
      <button class="tool" type="button" aria-pressed="false"><span class="ic"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="12" fill="none" stroke="url(#g)" stroke-width="3.4"/></svg></span><span class="lbl">{t("t.ellipse")}</span><span class="key">O</span></button>
      <button class="tool" type="button" aria-pressed="true"><span class="ic"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="13" fill="none" stroke="url(#g)" stroke-width="3.2"/><text class="fill" x="20" y="25.5" text-anchor="middle" font-family="-apple-system, Inter, sans-serif" font-size="15" font-weight="800" fill="url(#g)">1</text></svg></span><span class="lbl">{t("t.counter")}</span><span class="key">N</span></button>
      <button class="tool" type="button" aria-pressed="false"><span class="ic"><svg viewBox="0 0 40 40"><text class="fill" x="20" y="27" text-anchor="middle" font-family="-apple-system, Inter, sans-serif" font-size="19" font-weight="800" fill="url(#g)">Aa</text></svg></span><span class="lbl">{t("t.text")}</span><span class="key">T</span></button>
      <button class="tool" type="button" aria-pressed="false"><span class="ic"><svg viewBox="0 0 40 40"><path d="M8 28c4-8 8-12 11-12s1 8 4 8 7-11 10-12" fill="none" stroke="url(#g)" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="lbl">{t("t.pen")}</span><span class="key">P</span></button>
      <button class="tool" type="button" aria-pressed="false"><span class="ic"><svg viewBox="0 0 40 40"><g class="fill" fill="url(#g)"><rect x="8" y="8" width="7" height="7" rx="1.5"/><rect x="16.5" y="8" width="7" height="7" rx="1.5" opacity=".4"/><rect x="25" y="8" width="7" height="7" rx="1.5"/><rect x="8" y="16.5" width="7" height="7" rx="1.5" opacity=".4"/><rect x="16.5" y="16.5" width="7" height="7" rx="1.5"/><rect x="25" y="16.5" width="7" height="7" rx="1.5" opacity=".4"/><rect x="8" y="25" width="7" height="7" rx="1.5"/><rect x="16.5" y="25" width="7" height="7" rx="1.5" opacity=".4"/><rect x="25" y="25" width="7" height="7" rx="1.5"/></g></svg></span><span class="lbl">{t("t.pixel")}</span><span class="key">B</span></button>
      <button class="tool" type="button" aria-pressed="false"><span class="ic"><svg viewBox="0 0 40 40"><path d="M13 6v19a3 3 0 0 0 3 3h18M6 13h19a3 3 0 0 1 3 3v18" fill="none" stroke="url(#g)" stroke-width="3.4" stroke-linecap="round"/></svg></span><span class="lbl">{t("t.crop")}</span><span class="key">C</span></button>
    </div>

    <div class="show reveal">
      <div class="tabs" role="tablist">
        <button role="tab" type="button" aria-selected="true" data-tab="0">{t("tab.mark")}</button>
        <button role="tab" type="button" aria-selected="false" data-tab="1">{t("tab.shape")}</button>
        <button role="tab" type="button" aria-selected="false" data-tab="2">{t("tab.pixel")}</button>
        <button role="tab" type="button" aria-selected="false" data-tab="3">{t("tab.bg")}</button>
        <button role="tab" type="button" aria-selected="false" data-tab="4">{t("tab.ar")}</button>
      </div>
      <div class="stage">
        <figure>{TAB_MODES.map((mode, i) => <div class="tab-ed" data-panel={i} hidden={i !== 0}><div class={`ed m-${mode}`} set:html={edHTML(mode, lang)} /></div>)}</figure>
        <div>{TABS.map((item, i) => <div class="txt tab-txt" data-panel={i} hidden={i !== 0}><h3>{item.t}</h3><p>{item.b}</p><span class="keys">{item.k.map(k => <span class="key">{k}</span>)}</span></div>)}</div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="center narrow reveal">
      <span class="eyebrow">{t("more.eyebrow")}</span>
      <h2 class="h2">{t("more.title")}</h2>
    </div>
    <div class="bento">
      <article class="b s4 reveal">
        <div><h3>{t("style.t")}</h3><p>{t("style.b")}</p></div>
        <div class="art" aria-hidden="true"><div class="style-art">
          <svg viewBox="0 0 120 64"><path d="M10 14h100" stroke="var(--ink)" stroke-width="4" stroke-linecap="round"/><path d="M10 32h100" stroke="#EF852E" stroke-width="4" stroke-linecap="round" stroke-dasharray="10 9"/><path d="M10 50h100" stroke="#4790FB" stroke-width="4" stroke-linecap="round" stroke-dasharray="0 9"/></svg>
          <svg viewBox="0 0 64 64"><rect x="8" y="12" width="48" height="40" rx="10" fill="#FFE79D" fill-opacity=".7" stroke="#EF852E" stroke-width="3.5" stroke-dasharray="8 6"/></svg>
          <svg viewBox="0 0 64 64"><path d="M32 6l26 26-26 26L6 32z" fill="#C1D9FE" stroke="#4790FB" stroke-width="3.5" stroke-linejoin="round" transform="rotate(15 32 32)"/></svg>
          <svg viewBox="0 0 64 64"><ellipse cx="32" cy="32" rx="26" ry="20" fill="none" stroke="#1AAE54" stroke-width="3.5" stroke-dasharray="0 7" stroke-linecap="round"/></svg>
          <svg viewBox="0 0 80 64"><path d="M8 52C20 18 50 10 66 16" fill="none" stroke="#EA5E59" stroke-width="4" stroke-linecap="round"/><path d="M56 8l12 8-10 10" fill="none" stroke="#EA5E59" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div></div>
      </article>
      <article class="b s2 reveal">
        <div><h3>{t("fmt.t")}</h3><p>{t("fmt.b")}</p></div>
        <div class="art" aria-hidden="true"><div class="formats"><span class="on">PNG</span><span>JPEG</span><span>HEIC</span><span>TIFF</span></div></div>
      </article>
      <article class="b s2 reveal">
        <div><h3>{t("preset.t")}</h3><p>{t("preset.b")}</p></div>
        <div class="art" aria-hidden="true"><div class="plist">
          <div class="on"><i class="sw-plain"></i><span>{t("pr.plain")}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg></div>
          <div><i class="sw-dark"></i><span>{t("pr.dark")}</span></div>
          <div><i class="sw-social"></i><span>Social 16:9</span><em>JPEG</em></div>
        </div></div>
      </article>
      <article class="b s2 reveal">
        <div><h3>{t("sc.t")}</h3><p>{t("sc.b")}</p></div>
        <div class="art" aria-hidden="true"><div class="sc">
          <div class="on"><span>{t("mode.area")}</span><span class="keys"><span class="key">⌥</span><span class="key">⇧</span><span class="key">⌘</span><span class="key">4</span></span></div>
          <div><span>{t("mode.window")}</span><span class="keys"><span class="key">⌥</span><span class="key">⇧</span><span class="key">⌘</span><span class="key">5</span></span></div>
        </div></div>
      </article>
      <article class="b s2 reveal">
        <div><h3>{t("zoom.t")}</h3><p>{t("zoom.b")}</p></div>
        <div class="art" aria-hidden="true" style="padding:0"><div class="zoom"><div class="zfrag" dir="ltr"><span class="zn">2</span><span class="zpay">Pay $48.00</span></div><div class="zoom-ctl"><span>−</span><span class="on">200%</span><span>+</span></div></div></div>
      </article>
      <article class="b s3 reveal">
        <div><h3>{t("ap.t")}</h3><p>{t("ap.b")}</p></div>
        <div class="art" aria-hidden="true" style="padding:0"><div class="mode-sw"><span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><b>{t("ap.light")}</b></span><span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg><b>{t("ap.dark")}</b></span><span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg><b>{t("ap.auto")}</b></span></div></div>
      </article>
      <article class="b s3 reveal">
        <div><h3>{t("crop.t")}</h3><p>{t("crop.b")}</p></div>
        <div class="art" aria-hidden="true"><div class="formats"><span>1280 × 720</span><span class="on">1600 × 900</span><span>50%</span></div></div>
      </article>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="arabic reveal">
      <div>
        <span class="eyebrow">{t("ar.eyebrow")}</span>
        <h2 class="h2">{t("ar.title")}</h2>
        <p class="sub">{t("ar.sub")}</p>
        <div class="langs"><span>English</span><span>العربية</span><span>Français</span><span>Español</span><span>Deutsch</span></div>
      </div>
      <div class="ar-big" set:html={t("ar.big")} />
      <figure class="ar-stage"><div class="ed m-ar" role="img" aria-label={t("hero.alt")} set:html={edHTML("ar", lang)} /></figure>
    </div>
  </div>
</section>

<section class="night" id="privacy">
  <div class="wrap center">
    <div class="shield reveal"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2.4"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></div>
    <div class="narrow reveal">
      <span class="eyebrow">{t("priv.eyebrow")}</span>
      <h2 class="h2">{t("priv.title")}</h2>
      <p class="sub">{t("priv.sub")}</p>
    </div>
    <div class="promises">
      <div class="reveal"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6M3 3l18 18"/></svg><b>{t("p.1t")}</b><span>{t("p.1b")}</span></div>
      <div class="reveal"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a5 5 0 0 1-.5-10A6 6 0 0 1 18 9a4.5 4.5 0 0 1-.5 9z"/><path d="M3 3l18 18"/></svg><b>{t("p.2t")}</b><span>{t("p.2b")}</span></div>
      <div class="reveal"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/><path d="M3 3l18 18"/></svg><b>{t("p.3t")}</b><span>{t("p.3b")}</span></div>
      <div class="reveal"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg><b>{t("p.4t")}</b><span>{t("p.4b")}</span></div>
    </div>
    <div style="margin-top:44px; display:flex; justify-content:center"><a class="btn btn-line" href={privacyHref}>{t("priv.link")}</a></div>
  </div>
</section>

<section class="section" id="faq">
  <div class="wrap">
    <div class="center narrow reveal">
      <span class="eyebrow">{t("faq.eyebrow")}</span>
      <h2 class="h2">{t("faq.title")}</h2>
    </div>
    <div class="faq" id="faq-list">
      <details class="reveal" open><summary>{t("q.1")}</summary><p>{t("a.1")}</p></details>
      <details class="reveal"><summary>{t("q.2")}</summary><p>{t("a.2")}</p></details>
      <details class="reveal"><summary>{t("q.3")}</summary><p>{t("a.3")}</p></details>
      <details class="reveal"><summary>{t("q.4")}</summary><p>{t("a.4")}</p></details>
      <details class="reveal"><summary>{t("q.5")}</summary><p>{t("a.5")}</p></details>
    </div>
  </div>
</section>

<section class="final" id="get">
  <div class="wrap narrow">
    <img class="reveal" src="/icon.png" width="140" height="140" alt="" loading="lazy">
    <h2 class="h2 reveal">{t("final.title")}</h2>
    <div class="actions reveal">
      <a class="btn btn-dark" href={storeHref}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg><span>{t("hero.cta")}</span></a>
    </div>
    <p class="fine">{t("hero.meta")}</p>
  </div>
</section>
</main>
