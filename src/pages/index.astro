---
import Base from "../layouts/Base.astro";
import Home from "../components/Home.astro";
import { SITE, LANGS, pagePath, useT, type Lang } from "../i18n";
import { appNode, faqNode } from "../lib/seo";

const lang: Lang = "en";
const t = useT(lang);
const alternates = Object.fromEntries(LANGS.map(l => [l, pagePath(l)])) as Record<Lang, string>;
const faq = [1, 2, 3, 4, 5].map(n => ({ q: t(`q.${n}`), a: t(`a.${n}`) }));
---
<Base lang={lang} title={t("seo.title")} description={t("seo.desc")} alternates={alternates} graph={[appNode(lang), faqNode(SITE + pagePath(lang), lang, faq)]}>
  <Home lang={lang} />
</Base>
