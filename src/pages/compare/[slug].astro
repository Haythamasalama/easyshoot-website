---
import ArticlePage from "../../components/ArticlePage.astro";
import { COMPARES as LIST } from "../../i18n/articles";

export function getStaticPaths() {
  return LIST.map(article => ({ params: { slug: article.slug }, props: { article } }));
}
const { article } = Astro.props;
---
<ArticlePage lang="en" article={article} />
